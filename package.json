{
  "name": "sistema-documentacion",
  "version": "4.0.0",
  "private": true,
  "description": "Motor local determinista de documentación arquitectónica para Obsidian",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "start": "node scripts/bootstrap.mjs",
    "docs": "node scripts/cli.mjs",
    "mcp": "node scripts/mcp.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "copilot:config": "node scripts/print-mcp-config.mjs",
    "workspace:install": "node scripts/install-workspace.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "release": "node scripts/release.mjs",
    "profiles": "node scripts/generate-profiles.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tree-sitter-wasm": "2.0.2",
    "typescript": "7.0.2"
  }
}
