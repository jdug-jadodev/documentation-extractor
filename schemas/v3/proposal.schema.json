{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsys.local/schemas/v3/proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_type", "status", "objective", "scope", "exclusions", "current_state", "current_flow", "target_flow", "proposed_changes", "affected_components", "changes_by_repository", "responsibilities", "requirements", "contracts", "data_and_ownership", "reactive_behavior", "phases", "deployment_order", "acceptance_criteria", "validation", "tests", "risks", "rollback", "alternatives", "pending_decisions", "documentary_evidence", "evidence_ids", "confidence", "facts", "inferences", "decisions"],
  "properties": {
    "schema_version": {"const": 3},
    "proposal_type": {"enum": ["specification", "migration", "adr"]},
    "status": {"const": "review_required"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"$ref": "#/$defs/strings"},
    "exclusions": {"$ref": "#/$defs/strings"},
    "current_state": {"$ref": "#/$defs/strings"},
    "current_flow": {"$ref": "#/$defs/strings"},
    "target_flow": {"$ref": "#/$defs/strings"},
    "proposed_changes": {"$ref": "#/$defs/strings"},
    "affected_components": {"$ref": "#/$defs/strings"},
    "requirements": {"$ref": "#/$defs/strings"},
    "contracts": {"$ref": "#/$defs/strings"},
    "data_and_ownership": {"$ref": "#/$defs/strings"},
    "reactive_behavior": {"$ref": "#/$defs/strings"},
    "phases": {"$ref": "#/$defs/strings"},
    "deployment_order": {"$ref": "#/$defs/strings"},
    "acceptance_criteria": {"$ref": "#/$defs/strings"},
    "validation": {"$ref": "#/$defs/strings"},
    "tests": {"$ref": "#/$defs/strings"},
    "risks": {"$ref": "#/$defs/strings"},
    "rollback": {"$ref": "#/$defs/strings"},
    "alternatives": {"$ref": "#/$defs/strings"},
    "pending_decisions": {"$ref": "#/$defs/strings"},
    "evidence_ids": {"$ref": "#/$defs/strings"},
    "facts": {"$ref": "#/$defs/strings"},
    "inferences": {"$ref": "#/$defs/strings"},
    "decisions": {"$ref": "#/$defs/strings"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "changes_by_repository": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repository_id", "changes", "document_paths"], "properties": {"repository_id": {"type": "string"}, "changes": {"$ref": "#/$defs/strings"}, "document_paths": {"$ref": "#/$defs/strings"}}}},
    "responsibilities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repository_id", "role", "basis"], "properties": {"repository_id": {"type": "string"}, "role": {"type": "string"}, "basis": {"enum": ["extracted", "explicit", "inferred"]}}}},
    "documentary_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["chunk_id", "document_path", "evidence_ids"], "properties": {"chunk_id": {"type": "string"}, "document_path": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/strings"}}}}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}}
}
