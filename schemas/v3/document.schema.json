{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsys.local/schemas/v3/document.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_id", "run_id", "title", "repositories", "snapshots", "status", "format", "language", "archify", "sections"],
  "properties": {"schema_version": {"const": 3}, "document_id": {"type": "string"}, "run_id": {"type": "string"}, "title": {"type": "string"}, "repositories": {"type": "array", "items": {"type": "string"}}, "snapshots": {"type": "array"}, "status": {"enum": ["review", "review_required", "approved"]}, "format": {"const": "ASD-TSE-100"}, "language": {"const": "es-CO"}, "archify": {"type": "object"}, "sections": {"type": "array", "minItems": 16}}
}
