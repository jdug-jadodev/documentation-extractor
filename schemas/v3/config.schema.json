{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsys.local/schemas/v3/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "setup_status", "workspace_file", "vault_path", "repositories", "ai", "sharing", "azure"],
  "properties": {
    "schema_version": {"const": 3},
    "setup_status": {"enum": ["configuration_pending", "configured"]},
    "workspace_file": {"type": ["string", "null"]},
    "vault_path": {"type": "string", "minLength": 1},
    "state_path": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "enabled", "default_branch"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "path": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "default_branch": {"type": ["string", "null"]}
        }
      }
    },
    "documentation": {"type": "object", "additionalProperties": false, "required": ["include_tests"], "properties": {"include_tests": {"const": false}}},
    "documentation_intelligence": {"type": "object", "additionalProperties": false, "required": ["enabled", "max_context_tokens", "max_documents", "max_flows", "max_symbols", "max_documents_per_repository", "include_tests_by_default"], "properties": {"enabled": {"type": "boolean"}, "max_context_tokens": {"type": "integer", "minimum": 1000, "maximum": 200000}, "max_documents": {"type": "integer", "minimum": 1, "maximum": 500}, "max_flows": {"type": "integer", "minimum": 1, "maximum": 100}, "max_symbols": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_documents_per_repository": {"type": "integer", "minimum": 1, "maximum": 200}, "include_tests_by_default": {"const": false}}},
    "investigation": {"type": "object", "additionalProperties": false, "required": ["max_dependency_depth", "default_max_files", "hard_max_files", "default_max_bytes", "hard_max_bytes", "allow_repository_wide_scan"], "properties": {"max_dependency_depth": {"type": "integer", "minimum": 1, "maximum": 10}, "default_max_files": {"type": "integer", "minimum": 1, "maximum": 100}, "hard_max_files": {"type": "integer", "minimum": 1, "maximum": 200}, "default_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760}, "hard_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 52428800}, "allow_repository_wide_scan": {"const": false}}},
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "strong_model", "max_invocations"],
      "properties": {
        "provider": {"const": "copilot-cli"},
        "model": {"type": ["string", "null"]},
        "strong_model": {"type": ["string", "null"]},
        "max_invocations": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["local", "folder", "export"]}}
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}, "repository_url": {"type": "string"}, "branch": {"type": "string"}}
    },
    "overrides": {"type": "object"}
  }
}
