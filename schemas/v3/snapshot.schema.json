{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsys.local/schemas/v3/snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository_id", "requested_ref", "resolved_ref", "commit_oid", "capture_mode", "content_hash", "dirty", "captured_at"],
  "properties": {
    "schema_version": {"const": 3}, "id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1},
    "requested_ref": {"type": "string", "minLength": 1}, "resolved_ref": {"type": "string", "minLength": 1}, "commit_oid": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "capture_mode": {"enum": ["git", "working_tree"]}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dirty": {"type": "boolean"}, "captured_at": {"type": "string", "format": "date-time"}
  }
}
